# Обязательные параметры
ALLOWED_ORIGINS=https://REPLACE_WITH_FINAL_SITE_ORIGIN
YDB_CONNECTION_STRING=grpcs://ydb.serverless.yandexcloud.net:2135/?database=/ru-central1/REPLACE
YDB_TABLE_NAME=lci_leads

# Telegram: если оба поля пусты, канал пропускается.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# false — безопасное значение по умолчанию: контакты остаются в YDB.
TELEGRAM_INCLUDE_CONTACTS=false

# Почтовый fallback: заполнить весь блок либо оставить весь блок пустым.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
EMAIL_INCLUDE_CONTACTS=true

# Только для локальной разработки. В облачной функции НЕ устанавливать.
# LEAD_STORAGE_MODE=memory
